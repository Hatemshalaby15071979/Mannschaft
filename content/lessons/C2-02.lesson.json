  "scene": {
    "setting_de": "Eine Bibliothek am Abend. Zwei Menschen sprechen leise.",
    "setting_en": "A library in the evening. Two people speak quietly.",
    "register": "literary",
    "can_do_de": "Ich kann einen literarischen Dialog mit Rhythmus, Pausen und Andeutungen verstehen und sprechen.",
    "can_do_en": "I can understand and speak a literary dialogue with rhythm, pauses, and suggestion.",
    "situation_tags": ["literature", "culture", "atmosphere"],
    "grammar_focus": ["stil", "rhythmus", "pausen"]
  },
  "cast": [
    { "role": "narrator", "voice": "de_narrator_f", "lang": "de" },
    { "role": "frau", "voice": "de_young_f", "lang": "de" },
    { "role": "herr", "voice": "de_older_m", "lang": "de" }
  ],
  "segments": [
    {
      "id": "s001", "type": "scene", "speaker": "narrator",
      "text": "Eine Bibliothek am Abend. Zwei Menschen sprechen leise.",
      "translation": "A library in the evening. Two people speak quietly.",
      "pause_after_ms": 900
    },
    {
      "id": "s002", "type": "line", "speaker": "frau",
      "text": "Du bist spät gekommen.",
      "translation": "You came late.",
      "pause_after_ms": 900,
      "gloss": ["g_dialog"]
    },
    {
      "id": "s003", "type": "line", "speaker": "herr",
      "text": "Die Stadt war laut. Ich habe den Weg zu Fuß genommen.",
      "translation": "The city was loud. I took the way on foot.",
      "pause_after_ms": 900,
      "gloss": ["g_weg", "g_zu_fuss"]
    },
    {
      "id": "s004", "type": "line", "speaker": "frau",
      "text": "Und trotzdem bist du hier.",
      "translation": "And nevertheless you are here.",
      "pause_after_ms": 900
    },
    {
      "id": "s005", "type": "line", "speaker": "herr",
      "text": "Ja. Trotzdem.",
      "translation": "Yes. Nevertheless.",
      "pause_after_ms": 1200
    },
    {
      "id": "s006", "type": "check", "speaker": "narrator",
      "text": "Warum ist der Mann zu spät gekommen?",
      "translation": "Why did the man come late?",
      "answers": ["Er hat den Weg zu Fuß genommen."],
      "answer_pause_ms": 3500,
      "pause_after_ms": 400
    },
    {
      "id": "s007", "type": "note", "speaker": "narrator",
      "text": "Literarische Sprache lebt von kurzen Sätzen, Wiederholungen und Pausen.",
      "translation": "Literary language lives on short sentences, repetitions, and pauses.",
      "speed": 1.0, "pause_after_ms": 600, "skippable": true
    },
    {
      "id": "s008", "type": "line", "speaker": "frau",
      "text": "Setz dich. Das Licht ist noch an.",
      "translation": "Sit down. The light is still on.",
      "pause_after_ms": 800,
      "gloss": ["g_licht"]
    },
    {
      "id": "s009", "type": "line", "speaker": "herr",
      "text": "Ich sehe, du hast gewartet.",
      "translation": "I see you waited.",
      "pause_after_ms": 900,
      "gloss": ["g_warten"]
    },
    {
      "id": "s010", "type": "line", "speaker": "frau",
      "text": "Ich warte selten. Aber heute.",
      "translation": "I rarely wait. But today.",
      "pause_after_ms": 1000
    },
    {
      "id": "s011", "type": "line", "speaker": "herr",
      "text": "Es riecht nach alten Büchern.",
      "translation": "It smells of old books.",
      "pause_after_ms": 900,
      "gloss": ["g_riechen"]
    },
    {
      "id": "s012", "type": "line", "speaker": "frau",
      "text": "Es riecht nach Zeit.",
      "translation": "It smells of time.",
      "pause_after_ms": 1200,
      "gloss": ["g_zeit"]
    },
    {
      "id": "s013", "type": "check", "speaker": "narrator",
      "text": "Was sagt die Frau über den Geruch der Bibliothek?",
      "translation": "What does the woman say about the library's smell?",
      "answers": ["Es riecht nach Zeit."],
      "answer_pause_ms": 3500,
      "pause_after_ms": 400
    },
    {
      "id": "s014", "type": "drill", "speaker": "herr",
      "text": "Ich habe den Weg zu Fuß genommen.",
      "translation": "I took the way on foot.",
      "repeat": 2, "speed": 1.0, "pause_after_ms": 1000
    },
    {
      "id": "s015", "type": "line", "speaker": "herr",
      "text": "Wollen wir anfangen?",
      "translation": "Shall we begin?",
      "pause_after_ms": 800
    },
    {
      "id": "s016", "type": "line", "speaker": "frau",
      "text": "Ja. Lies mir vor.",
      "translation": "Yes. Read to me.",
      "pause_after_ms": 900,
      "gloss": ["g_vorlesen"]
    },
    {
      "id": "s017", "type": "line", "speaker": "herr",
      "text": "Von Anfang an?",
      "translation": "From the beginning?",
      "pause_after_ms": 900,
      "gloss": ["g_anfang"]
    },
    {
      "id": "s018", "type": "line", "speaker": "frau",
      "text": "Von Anfang an.",
      "translation": "From the beginning.",
      "pause_after_ms": 1400
    },
    {
      "id": "s019", "type": "check", "speaker": "narrator",
      "text": "Was soll der Mann tun?",
      "translation": "What should the man do?",
      "answers": ["Er soll ihr vorlesen."],
      "answer_pause_ms": 3500,
      "pause_after_ms": 400
    },
    {
      "id": "s020", "type": "vocab", "speaker": "narrator",
      "text": "vorlesen",
      "translation": "to read aloud",
      "pause_after_ms": 800,
      "gloss": ["g_vorlesen"]
    },
    {
      "id": "s021", "type": "vocab", "speaker": "narrator",
      "text": "die Bibliothek",
      "translation": "the library",
      "pause_after_ms": 800,
      "gloss": ["g_bibliothek"]
    },
    {
      "id": "s022", "type": "recap", "speaker": "narrator",
      "text": "Heute hast du gelernt: literarische Dialoge mit Rhythmus und Pausen.",
      "translation": "Today you learned: literary dialogues with rhythm and pauses.",
      "pause_after_ms": 700
    }
  ],
