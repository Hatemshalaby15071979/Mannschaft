    {
      "id": "s019", "type": "check", "speaker": "narrator",
      "text": "Wie alt ist Anna?",
      "translation": "How old is Anna?",
      "answers": ["fünfundzwanzig"],
      "answer_pause_ms": 2500,
      "pause_after_ms": 400
    },
    {
      "id": "s020", "type": "line", "speaker": "tom",
      "text": "Sprichst du auch Englisch?",
