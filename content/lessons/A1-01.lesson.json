  "segments": [
    {
      "id": "s001", "type": "scene", "speaker": "narrator",
      "text": "Erster Tag im Deutschkurs. Anna kommt in den Raum.",
      "translation": "First day at the German course. Anna comes into the room.",
      "pause_after_ms": 800
    },
    {
      "id": "s002", "type": "line", "speaker": "anna",
      "text": "Hallo!",
      "translation": "Hello!",
      "pause_after_ms": 500,
      "gloss": ["g_hallo"]
    },
    {
      "id": "s003", "type": "line", "speaker": "tom",
      "text": "Hallo! Ich bin Tom.",
      "translation": "Hello! I'm Tom.",
      "pause_after_ms": 700,
      "gloss": ["g_ich_bin"]
    },
    {
      "id": "s004", "type": "line", "speaker": "anna",
      "text": "Ich bin Anna. Freut mich.",
      "translation": "I'm Anna. Nice to meet you.",
      "pause_after_ms": 800,
      "gloss": ["g_freut_mich"]
    },
    {
      "id": "s005", "type": "echo", "speaker": "anna",
      "text": "Freut mich.",
      "translation": "Nice to meet you.",
      "repeat": 2, "speed": 0.8, "pause_after_ms": 1200
