    },
    {
      "id": "s017", "type": "line", "speaker": "anna",
      "text": "Ich bin fünfundzwanzig.",
      "translation": "I'm twenty-five.",
      "pause_after_ms": 700,
      "gloss": ["g_jahre_alt"]
    },
    {
      "id": "s018", "type": "drill", "speaker": "anna",
      "text": "Ich bin fünfundzwanzig Jahre alt.",
      "translation": "I am twenty-five years old.",
      "repeat": 2, "speed": 0.8, "pause_after_ms": 1000
