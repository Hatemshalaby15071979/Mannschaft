      "pause_after_ms": 700,
      "gloss": ["g_was_machst_du"]
    },
    {
      "id": "s012", "type": "line", "speaker": "tom",
      "text": "Ich bin Student. Ich lerne auch Deutsch.",
      "translation": "I'm a student. I'm also learning German.",
      "pause_after_ms": 800,
      "gloss": ["g_student", "g_lernen"]
    },
    {
      "id": "s013", "type": "echo", "speaker": "tom",
      "text": "Ich lerne auch Deutsch.",
      "translation": "I'm also learning German.",
      "repeat": 2, "speed": 0.8, "pause_after_ms": 1200
    },
    {
      "id": "s014", "type": "check", "speaker": "narrator",
      "text": "Was macht Tom?",
