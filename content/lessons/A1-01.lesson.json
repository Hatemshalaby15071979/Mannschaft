  "title": { "de": "Begrüßung und Vorstellung", "en": "Greetings and introductions" },
  "minutes": 8,
  "scene": {
    "setting_de": "Erster Tag im Deutschkurs. Anna kommt in den Raum und trifft Tom.",
    "setting_en": "First day at the German course. Anna comes into the room and meets Tom.",
    "register": "informal",
    "can_do_de": "Ich kann mich vorstellen, nach dem Namen und dem Land fragen und sagen, was ich mache.",
    "can_do_en": "I can introduce myself, ask for a name and a country, and say what I do.",
    "situation_tags": ["first-day", "introductions", "small-talk"],
    "grammar_focus": ["ich-bin-du-bist", "w-fragen", "praesens"]
  },
  "cast": [
