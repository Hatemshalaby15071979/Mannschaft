    {
      "id": "s006", "type": "line", "speaker": "tom",
      "text": "Woher kommst du, Anna?",
      "translation": "Where are you from, Anna?",
      "pause_after_ms": 700,
      "gloss": ["g_woher", "g_kommen_aus"]
    },
    {
      "id": "s007", "type": "line", "speaker": "anna",
      "text": "Ich komme aus Spanien. Und du?",
      "translation": "I'm from Spain. And you?",
      "pause_after_ms": 800,
      "gloss": ["g_kommen_aus"]
    },
    {
      "id": "s008", "type": "line", "speaker": "tom",
      "text": "Ich komme aus Deutschland. Ich wohne in Berlin.",
