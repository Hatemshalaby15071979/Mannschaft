      "text": "Woher kommt Anna?",
      "translation": "Where is Anna from?",
      "answers": ["aus Spanien"],
      "answer_pause_ms": 2500,
      "pause_after_ms": 400
    },
    {
      "id": "s010", "type": "note", "speaker": "narrator",
      "text": "Woher kommst du? fragt nach dem Land. Wo wohnst du? fragt nach der Stadt.",
