      "id": "s021", "type": "line", "speaker": "anna",
      "text": "Ja, ein bisschen. Und ein bisschen Deutsch.",
      "translation": "Yes, a little. And a little German.",
      "pause_after_ms": 800,
      "gloss": ["g_ein_bisschen"]
    },
    {
      "id": "s022", "type": "note", "speaker": "narrator",
      "text": "ein bisschen heißt a little. Sehr nützlich, wenn du unsicher bist.",
      "translation": "ein bisschen means a little. Very useful when you are unsure.",
      "speed": 0.85, "pause_after_ms": 700, "skippable": true
    },
    {
      "id": "s023", "type": "vocab", "speaker": "narrator",
      "text": "ein bisschen",
      "translation": "a little",
      "pause_after_ms": 900,
      "gloss": ["g_ein_bisschen"]
    },
    {
      "id": "s024", "type": "line", "speaker": "tom",
      "text": "Willkommen im Kurs!",
      "translation": "Welcome to the course!",
      "pause_after_ms": 700,
      "gloss": ["g_willkommen", "g_kurs"]
    },
    {
      "id": "s025", "type": "line", "speaker": "anna",
      "text": "Danke! Ich freue mich.",
      "translation": "Thanks! I'm happy to be here.",
      "pause_after_ms": 700
    },
    {
      "id": "s026", "type": "echo", "speaker": "anna",
      "text": "Ich freue mich.",
      "translation": "I'm happy to be here.",
      "repeat": 2, "speed": 0.8, "pause_after_ms": 1200
    },
    {
      "id": "s027", "type": "check", "speaker": "narrator",
      "text": "Wie viele Sprachen spricht Anna?",
      "translation": "How many languages does Anna speak?",
      "answers": ["Spanisch, Englisch und ein bisschen Deutsch"],
      "answer_pause_ms": 2500,
      "pause_after_ms": 400
    },
    {
      "id": "s028", "type": "vocab", "speaker": "narrator",
      "text": "der Kurs",
      "translation": "the course",
      "pause_after_ms": 900,
      "gloss": ["g_kurs"]
    },
    {
      "id": "s029", "type": "line", "speaker": "tom",
      "text": "Der Kurs beginnt um neun Uhr.",
      "translation": "The course starts at nine o'clock.",
      "pause_after_ms": 700,
      "gloss": ["g_beginnen"]
    },
    {
      "id": "s030", "type": "line", "speaker": "anna",
      "text": "Super. Dann bis später!",
      "translation": "Great. See you later then!",
      "pause_after_ms": 700,
      "gloss": ["g_bis_spaeter"]
    },
    {
      "id": "s031", "type": "line", "speaker": "tom",
      "text": "Bis später, Anna!",
      "translation": "See you later, Anna!",
      "pause_after_ms": 900,
      "gloss": ["g_bis_spaeter"]
    },
    {
      "id": "s032", "type": "recap", "speaker": "narrator",
      "text": "Heute hast du gelernt: sich vorstellen, nach dem Land fragen und sagen, was du machst.",
      "translation": "Today you learned: introducing yourself, asking about a country, and saying what you do.",
      "pause_after_ms": 800
